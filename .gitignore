# =============================================================================
# .gitignore - ic-pub
# O Git guarda CÓDIGO e DOCUMENTAÇÃO. Dados e resultados são regeneráveis
# (limpeza -> consolidação -> levantamentos/figuras/comparação/multivariada)
# e ficam de fora.
# =============================================================================
 
# --- Dados (mantém só marcadores de pasta e LEIA-ME, se existirem) ------------
data/raw/*
!data/raw/.gitkeep
!data/raw/LEIA-ME.md
data/processed/*
!data/processed/.gitkeep
!data/processed/LEIA-ME.md
 
# --- Resultados gerados pelos scripts -----------------------------------------
# (comparacao_ti_comum/, figuras_por_ti/, levantamentos_por_ti/, multivariada/ ...)
output/*
!output/.gitkeep
!output/LEIA-ME.md
 
# --- Planilhas e arquivos pesados (em qualquer pasta) -------------------------
# *.csv NÃO é ignorado globalmente: assim tabelas de referência em docs/ entram.
# Os CSVs de dados já estão cobertos pelas regras de pasta acima.
*.xlsx
*.xlsb
*.xls
*.parquet
*.pkl
*.joblib
 
# --- Modelos / arquivos do Weka (descomente se não quiser versionar) ----------
# *.model
# *.arff
 
# --- Relatórios ---------------------------------------------------------------
# Relatórios antigos: só consulta
docs/relatorios_antigos/*
!docs/relatorios_antigos/.gitkeep
!docs/relatorios_antigos/LEIA-ME.md
 
# Auxiliares do LaTeX
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
 
# PDF compilado dos relatórios (descomente se quiser ignorar também)
# docs/**/main.pdf
 
# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
 
# --- Segredos e ambiente local ------------------------------------------------
.env
.env.*
 
# --- Editor / sistema ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
 